-- ==================== SCANNER ====================
local foundBackdoors = {}
local workingRemote = nil

local knownBackdoors = {"hiddenadmin", "hdadmin", "kohl", "feather", "admin", "mod", "backdoor", "exploit", "hiddensystem", "remotesystem", "adminpanel", "modpanel", "serveradmin", "gameadmin", "fe"}

local function isBackdoorName(name)
    local nameLower = string.lower(name)
    for _, keyword in ipairs(knownBackdoors) do
        if string.find(nameLower, keyword) then return true end
    end
    return false
end

local function runScan()
    task.wait(0.5)
    scanText.Text = "[1/3] Procurando RemoteEvents suspeitos..."
    task.wait(0.3)
    
    for _, obj in pairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            if isBackdoorName(obj.Name) then
                table.insert(foundBackdoors, {type = obj.ClassName, name = obj:GetFullName(), obj = obj})
                if not workingRemote then workingRemote = obj end
            end
        end
        task.wait()
    end
    
    scanText.Text = "[2/3] Encontrados " .. #foundBackdoors .. " backdoors..."
    task.wait(0.5)
    
    if #foundBackdoors == 0 then
        scanText.Text = "[2/3] Testando formato de comandos..."
        task.wait(0.3)
        
        for _, obj in pairs(game:GetDescendants()) do
            if obj:IsA("RemoteEvent") then
                local ok = pcall(function() obj:FireServer("admin", "test") end)
                if ok then
                    table.insert(foundBackdoors, {type = "RemoteEvent", name = obj:GetFullName(), obj = obj})
                    if not workingRemote then workingRemote = obj end
                    break
                end
            end
            task.wait()
        end
    end
    
    scanText.Text = "[3/3] Finalizando..."
    task.wait(0.5)
    
    if #foundBackdoors > 0 then
        scanText.Text = "⚠️ BACKDOORS: " .. #foundBackdoors .. "\n✅ Clique em INJETAR"
        scanText.TextColor3 = Color3.fromRGB(255, 100, 100)
        task.wait(2)
        scannerGui:Destroy()
        createAdminPanel()
    else
        scanText.Text = "❌ NENHUM BACKDOOR\nPainel NÃO será liberado."
        scanText.TextColor3 = Color3.fromRGB(100, 255, 100)
    end
end

task.spawn(runScan)

